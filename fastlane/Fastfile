default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight / App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false
    )

    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "temporary_build_password_123"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    delete_keychain(name: keychain_name) if File.exist?(keychain_path)

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 1. Import Apple WWDR Intermediate CA, Private Key & Certificate
    sh("curl -fsSL https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer -o AppleWWDRCAG3.cer && security import AppleWWDRCAG3.cer -k #{keychain_path} -T /usr/bin/codesign -T /usr/bin/security")

    key_path = File.expand_path("distribution_key.pem")
    cert_path = File.expand_path("distribution_cert.cer")
    File.write(key_path, ENV["APPLE_CERTIFICATE_KEY_PEM"])
    File.write(cert_path, Base64.decode64(ENV["APPLE_CERTIFICATE_CER_BASE64"]))

    sh("security import #{key_path} -k #{keychain_path} -P '' -T /usr/bin/codesign -T /usr/bin/security")
    sh("security import #{cert_path} -k #{keychain_path} -T /usr/bin/codesign -T /usr/bin/security")

    # Authorize codesign to access private keys in the keychain
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_password} #{keychain_path}")

    # Verify that the identity is valid and recognized by codesign
    sh("security find-identity -v -p codesigning #{keychain_path}")

    # 2. Fetch or generate App Store Provisioning Profile linked to our certificate
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "gr.greca994.radio",
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    # 3. Configure code signing with the fetched profile
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: "KAXY5WY64B",
      bundle_identifier: "gr.greca994.radio",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      code_sign_identity: "Apple Distribution"
    )

    # 4. Build IPA archive
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "gr.greca994.radio" => profile_name
        }
      },
      xcargs: "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\" CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" DEVELOPMENT_TEAM=KAXY5WY64B",
      output_directory: "build/ipa",
      output_name: "GrecaFM.ipa"
    )

    # 5. Deliver directly to App Store Connect TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ipa/GrecaFM.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
